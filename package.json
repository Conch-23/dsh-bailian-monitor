{
  "name": "dsh-bailian-monitor",
  "version": "0.1.4",
  "description": "DSH 桌面版百炼代金券余额和当前会话 Token 用量面板",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": { "dsh": ">=0.2.1-rc.3 <0.3.0", "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": ["lib", "cordis.patch.yml", "ram-policy.json", "README.md", "LICENSE", "CHANGELOG.md", "docs/preview.png"],
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "license": "MIT",
  "author": "Conch-23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conch-23/dsh-bailian-monitor.git"
  },
  "homepage": "https://github.com/Conch-23/dsh-bailian-monitor#readme",
  "bugs": { "url": "https://github.com/Conch-23/dsh-bailian-monitor/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "bailian", "aliyun", "coupon", "balance"]
}
